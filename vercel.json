{
  "installCommand": "exit 0",
  "buildCommand": "exit 0",
  "outputDirectory": "vercel-dashboard/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://82.153.118.72:4000/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "http://82.153.118.72:4000/auth/:path*"
    },
    {
      "source": "/g/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/owner",
      "destination": "/owner.html"
    },
    {
      "source": "/owner/:path*",
      "destination": "/owner.html"
    }
  ]
}
